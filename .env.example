# Supabase PostgreSQL connection string. Use the pooled connection for the app.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Optional direct connection for administrative tools if your Supabase setup requires it.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Set only when running the opt-in integration suite against a disposable database.
# NEVER set this to "true" while DATABASE_URL points at the shared/demo Supabase
# project — those tests call deleteMany()/full-table wipes. A safety guard
# (tests/helpers/db-safety.ts) refuses to run unless DATABASE_URL resolves to
# localhost/127.0.0.1, or to a host explicitly listed in
# TEST_DATABASE_HOST_ALLOWLIST below. See README.md for setup steps.
RUN_DATABASE_TESTS="false"

# Comma-separated hostnames explicitly allowed to run the destructive DB
# integration suite when they are not localhost — e.g. the host of a
# dedicated, disposable Supabase *test* project. Leave unset when using a
# local Postgres+PostGIS instance instead.
# TEST_DATABASE_HOST_ALLOWLIST="db.my-disposable-test-project.supabase.co"

# Base URL for the OSRM routing service
OSRM_BASE_URL="http://router.project-osrm.org"

# Supabase Auth (Stage 7). Both values come from Project Settings > API in the
# Supabase dashboard for the SAME project DATABASE_URL points at.
#
# NEXT_PUBLIC_SUPABASE_URL is the project's API URL (e.g.
# "https://[YOUR-PROJECT-REF].supabase.co"). It is not a secret.
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the project's public "anon"/"publishable"
# key. Despite the NEXT_PUBLIC_ prefix (required so the browser client can use
# it) this key is designed by Supabase to be public — it only ever acts as the
# calling user's own session, never with elevated privileges.
#
# The service-role key is intentionally NOT used anywhere in this app. Never
# add SUPABASE_SERVICE_ROLE_KEY to NEXT_PUBLIC_*, never send it to the
# browser, and do not introduce it unless a future stage has a specific,
# reviewed need for elevated Supabase Admin API access.
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
